    "license": "MIT",
    "private": true,
    "version": "1.0.0",
    "type": "commonjs",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js"
    },
    "keywords": [
        "development",
        "software",
        "Android",
        "mobile",
        "editor",
        "api"
    ],
    "contributors": [
        {
            "email": "jlucasmelob558@gmail.com",
            "name": "Lucas Melo",
            "url": "https://github.com/lucaaszsx"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/lucaaszsx/frequency-control.git"
    },
    "bugs": {
        "url": "https://github.com/lucaaszsx/frequency-control/issues"
    },
    "homepage": "https://github.com/lucaaszsx/frequency-control#README",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rimraf ./dist",
