{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "api-frequency-control",
    "description": "A school frequency control application for managing and monitoring student attendance.",
    "license": "MIT",
    "private": true,
    "version": "1.0.0",
    "type": "commonjs",
    "main": "dist/App.js",
    "keywords": [
        "development",
