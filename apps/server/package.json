        "@types/express": "^5.0.5",
        "@types/mime-types": "^3.0.1",
        "@types/morgan": "^1.9.10",
        "@types/node": "^22.19.7",
        "@types/sanitize-html": "^2.16.0",
        "nodemon": "^3.1.11",
        "rimraf": "^6.1.2",
