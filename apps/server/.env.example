# Environment mode (dev, prod, test)
NODE_ENV=dev


# ============================
# Server configuration
# ============================

# Port where the server will run
SERVER_PORT=3000

# Base URL of the server (used for links, CORS, etc.)
SERVER_BASE_URL=http://localhost:3000

# Prefix used in all API routes (e.g., /api/v1)
SERVER_ROUTE_PREFIX=/api/v1


# ============================
# CORS settings
# ============================

# Allowed origins (comma-separated)
SERVER_CORS_ORIGINS=http://localhost:3000

# Allowed HTTP methods
SERVER_CORS_METHODS=GET,POST,PUT,PATCH,DELETE

# Allowed headers
SERVER_CORS_HEADERS=Content-Type,Authorization

# Allow cookies / credentials
SERVER_CORS_CREDENTIALS=true


# ============================
# Rate limiting config
# ============================

# Window duration (e.g., 900000 = 15 minutes)
SERVER_RATE_LIMIT_WINDOW=900000

# Max requests per window per IP
SERVER_RATE_LIMIT_REQUESTS=100

# Send standard RateLimit headers
SERVER_RATE_LIMIT_STANDARD_HEADERS=true

# Send legacy X-RateLimit headers
SERVER_RATE_LIMIT_LEGACY_HEADERS=false


# ============================
# Body parser limits
# ============================

# JSON body size limit (e.g., 1mb, 10mb)
SERVER_JSON_LIMIT=1mb

# Enable JSON body inflate
SERVER_JSON_INFLATE=true

# URL-encoded body size limit
SERVER_URLENCODED_LIMIT=1mb


# ============================
# Application settings
# ============================

# Log file name
APP_LOG_FILENAME=app.log

# Logging level (error, warn, info, debug, trace)
APP_LOG_LEVEL=debug


# ============================
# Application directories
# ============================

APP_DIRS_LOGS=logs

APP_DIRS_CONTROLLERS=src/api/controllers
APP_DIRS_MIDDLEWARES=src/api/middlewares

APP_DIRS_ENTITIES=src/database/entities
APP_DIRS_MIGRATIONS=src/database/migrations
APP_DIRS_SUBSCRIBERS=src/database/subscribers


# ============================
# Cloudflare R2 (S3-compatible)
# ============================

R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_ACCOUNT_ID=your-account-id
R2_BUCKET_NAME=example-bucket
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Optional public/CDN endpoint
R2_PUB_ENDPOINT=https://cdn.example.dev

# Region (usually "auto")
R2_REGION=auto


# ============================
# Database configuration
# ============================

DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=devuser
DATABASE_PASSWORD=devpass
DATABASE_NAME=postgres
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false