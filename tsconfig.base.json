{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "strict": true,
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "moduleDetection": "force",

        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,

        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,

        "incremental": true
    }
}
